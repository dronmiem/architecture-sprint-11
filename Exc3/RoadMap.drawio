        <mxCell id="8EYzcnZTtMqWbIJYtl2--43" value="Проектирование доменов и Lakehouse,&amp;nbsp;описание потоков данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
